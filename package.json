{
  "name": "pi-beautiful-tui",
  "version": "0.2.0",
  "description": "A polished, multilingual and themeable TUI extension for the Pi coding agent.",
  "type": "module",
  "license": "MIT",
  "author": "smithyyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithyyang/pi-beautiful-tui.git"
  },
  "homepage": "https://github.com/smithyyang/pi-beautiful-tui#readme",
  "bugs": {
    "url": "https://github.com/smithyyang/pi-beautiful-tui/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "tui",
    "terminal",
    "theme",
    "telemetry"
